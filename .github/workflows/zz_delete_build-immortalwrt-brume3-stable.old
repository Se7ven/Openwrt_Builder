name: Immortalwrt Brume 3 stable

on:
  workflow_dispatch:

permissions:
  contents: write

env:
  WORKFLOW_NAME: "Immortalwrt Brume 3 stable"
  FEEDS_CONF: feeds.conf.default
  CONFIG_FILE: ./config/immortalwrt.config
  DIY_P1_SH: ./sh/scripts-part1.sh
  DIY_P2_SH: ./sh/scripts-part2.sh
  UPLOAD_BIN_DIR: false
  UPLOAD_FIRMWARE: true
  UPLOAD_RELEASE: true
  TZ: Europe/Berlin
  GOTOOLCHAIN: path

jobs:
  build:
    name: Compile GL-MT5000 Stable
    runs-on: ubuntu-26.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Free up disk space
        uses: jlumbroso/free-disk-space@main
        with:
          tool-cache: false
          android: true
          dotnet: true
          haskell: true
          large-packages: true
          docker-images: true
          swap-storage: true

      - name: Initialize build environment
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo rm -rf /etc/apt/sources.list.d/* /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo -E apt-get -qq update
          sudo -E apt-get -qq install -y dos2unix libfuse-dev build-essential libncurses5-dev gawk git libssl-dev gettext zlib1g-dev swig python3-distutils libelf-dev m4 flex bison
          sudo bash -c 'bash <(curl -s https://build-scripts.immortalwrt.org/init_build_environment.sh)' || true
          sudo timedatectl set-timezone "$TZ"
          sudo mkdir -p /workdir
          sudo chown $USER:$GROUPS /workdir

      - name: Clone source code
        working-directory: /workdir
        run: |
          git clone --depth 1 -b mt5000 https://github.com/GLiNet-Tech/openwrt.git openwrt
          ln -sf /workdir/openwrt $GITHUB_WORKSPACE/openwrt

      - name: Configure feeds and run DIY 1
        run: |
          cd openwrt
          echo "src-git packages https://github.com/immortalwrt/packages.git;openwrt-25.12" > feeds.conf.default
          echo "src-git luci https://github.com/immortalwrt/luci.git;openwrt-25.12" >> feeds.conf.default
          echo "src-git routing https://github.com/openwrt/routing.git;openwrt-25.12" >> feeds.conf.default
          echo "src-git telephony https://github.com/openwrt/telephony.git;openwrt-25.12" >> feeds.conf.default
          echo "src-git footstrap https://github.com/VizzleTF/luci-theme-footstrap.git" >> feeds.conf.default
          chmod +x $GITHUB_WORKSPACE/$DIY_P1_SH
          $GITHUB_WORKSPACE/$DIY_P1_SH
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Apply configuration and run DIY 2
        run: |
          [ -e $CONFIG_FILE ] && cp $CONFIG_FILE openwrt/.config
          chmod +x $DIY_P2_SH
          cd openwrt
          $GITHUB_WORKSPACE/$DIY_P2_SH

          make defconfig
          echo "=== Check selected target device ==="
          grep "CONFIG_TARGET.*DEVICE.*=y" .config || true

      - name: Download package sources
        run: |
          cd openwrt
          make download -j8
          find dl -size -1024c -exec rm -f {} \;

      - name: Compile firmware
        id: compile
        run: |
          cd openwrt
          echo "$(nproc) threads during compilation"
          make -j$(nproc) || make -j1 V=s
          grep '^CONFIG_TARGET.*DEVICE.*=y' .config | sed -r 's/.*DEVICE_(.*)=y/\1/' > DEVICE_NAME
          echo "compile=success" >> $GITHUB_OUTPUT
          echo "device-name=$(cat DEVICE_NAME)" >> $GITHUB_OUTPUT
          echo "file-date=$(date +"%Y%m%d%H%M")" >> $GITHUB_OUTPUT

      - name: Create release
        uses: softprops/action-gh-release@v2
        if: steps.compile.outputs.compile == 'success' && !cancelled()
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: GL-MT5000_immortal_25.12_${{ steps.compile.outputs.file-date }}
          name: ImmortalWrt 25.12 Stable ${{ steps.compile.outputs.file-date }}
          body: ImmortalWrt 25.12 feeds on native mt5000 configuration.
          files: |
            openwrt/bin/targets/*/*/*sysupgrade*
            openwrt/bin/targets/*/*/*factory*
            openwrt/bin/targets/*/*/*manifest*
            openwrt/bin/targets/*/*/*sha256sums
