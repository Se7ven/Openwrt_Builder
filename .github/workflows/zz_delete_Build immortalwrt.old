name: Build immortalwrt

on:
  workflow_dispatch:
    inputs:
      docker:
        description: 'Enable Docker'
        required: false
        default: 'false'

permissions:
  contents: write

env:
  FEEDS_CONF: feeds.conf.default
  CONFIG_FILE: ./config/mt5000.config
  CONFIG_FILE_DOCKER: ./config/immortalwrt.config
  DIY_P1_SH: ./sh/scripts-part1.sh
  DIY_P2_SH: ./sh/scripts-part2.sh
  UPLOAD_BIN_DIR: true
  UPLOAD_FIRMWARE: true
  UPLOAD_RELEASE: true
  TZ: Europe/Berlin
  GOTOOLCHAIN: path

jobs:
  build:
    name: Compile GL-MT5000 Master
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Free up disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo docker image prune --all --force

      - name: Initialize build environment
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo -E apt-get update
          sudo -E apt-get -y install dos2unix libfuse-dev build-essential libncurses5-dev gawk git libssl-dev gettext zlib1g-dev swig python3-distutils libelf-dev m4 flex bison
          sudo bash -c 'bash <(curl -s https://build-scripts.immortalwrt.org/init_build_environment.sh)'
          sudo timedatectl set-timezone "$TZ"
          sudo mkdir -p /workdir
          sudo chown $USER:$GROUPS /workdir
          echo "WORKFLOW_NAME=gl-mt5000_immortalwrt" >> $GITHUB_ENV

      - name: Clone source code
        working-directory: /workdir
        run: |
          git clone --depth 1 -b mt5000 https://github.com/GLiNet-Tech/openwrt.git openwrt
          ln -sf /workdir/openwrt $GITHUB_WORKSPACE/openwrt

      - name: Configure feeds and run DIY 1
        run: |
          cd openwrt
          echo "src-git packages https://github.com/immortalwrt/packages.git;master" > feeds.conf.default
          echo "src-git luci https://github.com/immortalwrt/luci.git;master" >> feeds.conf.default
          echo "src-git routing https://github.com/openwrt/routing.git;master" >> feeds.conf.default
          echo "src-git telephony https://github.com/openwrt/telephony.git;master" >> feeds.conf.default
          echo "src-git footstrap https://github.com/VizzleTF/luci-theme-footstrap.git" >> feeds.conf.default
          [ -f $GITHUB_WORKSPACE/$DIY_P1_SH ] && chmod +x $GITHUB_WORKSPACE/$DIY_P1_SH && $GITHUB_WORKSPACE/$DIY_P1_SH || true
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Apply configuration and run DIY 2
        run: |
          [ -e $CONFIG_FILE ] && cp $CONFIG_FILE openwrt/.config
          if [ "${{ github.event.inputs.docker }}" = "true" ] && [ -e $CONFIG_FILE_DOCKER ]; then
            cat $CONFIG_FILE_DOCKER >> openwrt/.config
          fi
          [ -f $DIY_P2_SH ] && chmod +x $DIY_P2_SH
          cd openwrt
          $GITHUB_WORKSPACE/$DIY_P2_SH

          make defconfig
          echo "=== Check selected target device ==="
          grep "CONFIG_TARGET.*DEVICE.*=y" .config || true

      - name: Download package sources
        run: |
          cd openwrt
          make download -j8
          find dl -size -1024c -exec rm -f {} \;

      - name: Compile firmware
        id: compile
        run: |
          cd openwrt
          echo "$(nproc) threads during compilation"
          make -j$(nproc) || make -j1 V=s
          grep '^CONFIG_TARGET.*DEVICE.*=y' .config | sed -r 's/.*DEVICE_(.*)=y/\1/' > DEVICE_NAME
          echo "compile=success" >> $GITHUB_OUTPUT
          echo "device-name=$(cat DEVICE_NAME)" >> $GITHUB_OUTPUT
          echo "file-date=$(date +"%Y%m%d%H%M")" >> $GITHUB_OUTPUT

      - name: Upload bin directory as artifact
        uses: actions/upload-artifact@v4
        if: steps.compile.outputs.compile == 'success' && env.UPLOAD_BIN_DIR == 'true'
        with:
          name: ImmortalWrt_bin_${{ steps.compile.outputs.device-name }}-${{ steps.compile.outputs.file-date }}
          path: openwrt/bin

      - name: Create release
        uses: softprops/action-gh-release@v2
        if: steps.compile.outputs.compile == 'success' && !cancelled()
        with:
          name: ImmortalWrt Brume 3 (GL-MT5000) Master ${{ steps.compile.outputs.file-date }}
          tag_name: ImmortalWrt_GL-MT5000_master_${{ steps.compile.outputs.file-date }}
          body: ImmortalWrt Master feeds on native mt5000 configuration.
          files: |
            openwrt/bin/targets/*/*/*sysupgrade*
            openwrt/bin/targets/*/*/*factory*
            openwrt/bin/targets/*/*/*manifest*
            openwrt/bin/targets/*/*/*sha256sums
